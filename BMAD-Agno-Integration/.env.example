# 全局环境配置
NODE_ENV=development
LOG_LEVEL=info

# 服务端口配置
AGNO_PORT=8000
BMAD_PORT=3000
APISIX_PORT=8080
LM_STUDIO_PORT=1234

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bmad_agno_db
DB_USER=postgres
DB_PASSWORD=pg123456
DB_POOL_SIZE=10

# 向量数据库配置
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=agno_memory
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=pg123456

# APISIX网关配置
APISIX_ADMIN_KEY=your-secret-admin-key
APISIX_ETCD_HOST=127.0.0.1
APISIX_ETCD_PORT=2379

# LM Studio配置 (框架代码使用，不实际部署)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_API_KEY=lm-studio-local
LM_STUDIO_MODEL=lmstudio-community/Llama-3-8B-Instruct-GGUF

# Redis配置 (可选，用于缓存)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 语音服务配置
ASR_MODEL_PATH=./models/whisper
TTS_MODEL_PATH=./models/vits
VOICEPRINT_MODEL_PATH=./models/voiceprint

# 视觉服务配置
YOLOV8_MODEL_PATH=./models/yolov8n-ui.onnx
TESSERACT_PATH=./tools/tesseract

# 日志配置
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# 安全配置
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 性能配置
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300
MEMORY_LIMIT=8GB

# 开发模式配置
DEBUG=true
HOT_RELOAD=true
MOCK_SERVICES=false
